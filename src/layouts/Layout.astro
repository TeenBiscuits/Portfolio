---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  personDescription?: string;
  ogLocale?: string;
  ogLocaleAlternate?: string[];
}

const {
  title = "Pablo Portas López",
  description = "Estudiante de Ingeniería Informática en la UDC",
  lang = "es",
  personDescription = "Estudiante de Ingeniería Informática en la Universidade da Coruña",
  ogLocale = "es_ES",
  ogLocaleAlternate = [],
} = Astro.props;

const canonicalUrl = `https://www.pablopl.dev${lang === "es" ? "" : `/${lang}`}`;

const jsonLdPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Pablo Portas López",
  url: "https://www.pablopl.dev/",
  jobTitle: title.replace("Pablo Portas López — ", ""),
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Universidade da Coruña (UDC)" },
    { "@type": "CollegeOrUniversity", name: "Linnaeus University (LNU)" },
  ],
  description: personDescription,
  sameAs: [
    "https://github.com/TeenBiscuits",
    "https://x.com/PabloPortasL",
    "https://www.linkedin.com/in/pabloportaslopez/",
  ],
  knowsLanguage: [
    { "@type": "Language", name: "Spanish" },
    { "@type": "Language", name: "English" },
    { "@type": "Language", name: "Galician" },
  ],
  nationality: { "@type": "Country", name: "ES" },
  homeLocation: { "@type": "Place", name: "Galicia, Spain" },
};

const jsonLdWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: "https://www.pablopl.dev/",
  name: "Pablo Portas López",
  description: description,
  inLanguage: ["es", "en", "gl"],
  author: jsonLdPerson,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://analytics.pablopl.dev" />
    <link rel="preconnect" href="https://analytics.ahrefs.com" />
    <!-- Fonts: inlined as early as possible for earliest font discovery -->
    <Font cssVariable="--font-merriweather" preload />
    <Font cssVariable="--font-rubik" preload />
    <Font cssVariable="--font-cascadia" preload />
    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=20260716" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260716" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260716" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260716" />
    <meta name="apple-mobile-web-app-title" content="Pablo Portas López" />
    <link rel="manifest" href="/site.webmanifest?v=20260716" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href="https://www.pablopl.dev/" />
    <link rel="alternate" hreflang="en" href="https://www.pablopl.dev/en" />
    <link rel="alternate" hreflang="gl" href="https://www.pablopl.dev/gl" />
    <link rel="alternate" hreflang="x-default" href="https://www.pablopl.dev/" />

    <!-- Open Graph -->
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternate.map((alt) => (
      <meta property="og:locale:alternate" content={alt} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.pablopl.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@PabloPortasL" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.pablopl.dev/og.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)}>
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)}>
    </script>
    <ClientRouter />

    <!-- Rybbit Analytics -->
    <script
      is:inline
      defer
      data-astro-rerun
      src="https://analytics.pablopl.dev/api/script.js"
      data-site-id="32c5b41dd6c6"></script>
    <!-- Ahrefs Analytics -->
    <script is:inline data-astro-rerun src="https://analytics.ahrefs.com/analytics.js" data-key="41AHUOkOrsmT26f+Ow8zaQ" async></script>

    <!-- Theme Inline Script to prevent theme flashing (FOUT) -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      };
      
      const theme = getTheme();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <script>
      const applyTheme = () => {
        const theme = localStorage.getItem("theme") || 
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      // Persist theme, track view transitions, and add navigated class after swaps
      document.addEventListener("astro:after-swap", () => {
        applyTheme();
        document.documentElement.classList.add("navigated");
        window.rybbit?.pageview();
      });

      // Add navigated class to initial load after animations complete (1000ms)
      const setupNavigated = () => {
        setTimeout(() => {
          document.documentElement.classList.add("navigated");
        }, 1000);
      };

      // Run on page load
      document.addEventListener("astro:page-load", setupNavigated);
    </script>
  </head>
  <body class="selection:bg-stone-200 dark:selection:bg-zinc-800 transition-colors duration-200">
    <slot />
    <script>
      import { bind } from "cuelume";
      bind();
    </script>
  </body>
</html>
