---
import type { PreviewKey } from "../config/previews";
import PreviewCard from "./PreviewCard.astro";

interface Props {
  href: string;
  site: PreviewKey;
  eventTitle: string;
}

const { href, site, eventTitle } = Astro.props;
const separator = href.includes("?") ? "&" : "?";
const utmHref = `${href}${separator}utm_source=portfolio&utm_medium=web&utm_campaign=bio`;
---

<span class="preview-link pl-trigger">
  <a
    href={utmHref}
    target="_blank"
    rel="noopener noreferrer"
    data-cuelume-press
    class="inline-flex items-center gap-0.5 font-medium text-stone-900 dark:text-zinc-100 hover:text-stone-700 dark:hover:text-zinc-300 underline decoration-stone-300 dark:decoration-zinc-700 hover:decoration-stone-500 dark:hover:decoration-zinc-500 transition-colors duration-200 cursor-pointer"
    data-rybbit-event="click-outbound-link"
    data-rybbit-prop-name={eventTitle}
    data-rybbit-prop-url={utmHref}
    data-rybbit-prop-type="Bio Link"
  >
    <slot />
  </a>

  <PreviewCard site={site} />
</span>

<style>
  .preview-link {
    position: relative;
    display: inline-block;
  }
</style>
