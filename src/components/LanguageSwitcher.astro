---
import type { Locale } from "../utils/i18n";

interface Props {
  activeLang: Locale;
}

const { activeLang } = Astro.props;

const locales: { code: Locale; label: string; href: string }[] = [
  { code: "es", label: "ES", href: "/" },
  { code: "en", label: "EN", href: "/en" },
  { code: "gl", label: "GL", href: "/gl" },
];
---

<nav 
  class="flex items-center gap-0.5 bg-stone-200/40 dark:bg-zinc-900/40 p-0.5 rounded-lg border border-stone-200/40 dark:border-zinc-800/30 transition-all duration-300 ease-[var(--ease-spring)]"
  transition:name="language-switcher-nav"
>
  {
    locales.map((locale) => {
      const isActive = activeLang === locale.code;
      return (
        <a
          href={locale.href}
          class={`px-2.5 py-1 text-[11px] font-mono rounded-md font-medium tracking-wider transition-all duration-300 ease-[var(--ease-spring)] focus:outline-none focus-visible:ring-1 focus-visible:ring-stone-400 dark:focus-visible:ring-zinc-600 ${
            isActive
              ? "bg-white dark:bg-zinc-800 text-stone-900 dark:text-zinc-100 shadow-[0_1px_2px_rgba(0,0,0,0.05)] border border-stone-200/20 dark:border-zinc-700/30 font-semibold"
              : "text-stone-500 hover:text-stone-800 dark:text-zinc-400 dark:hover:text-zinc-200 hover:bg-[rgba(28,25,23,0.03)] dark:hover:bg-[rgba(244,244,245,0.03)] border border-transparent"
          }`}
          transition:name={isActive ? "active-locale-pill" : undefined}
        >
          {locale.label}
        </a>
      );
    })
  }
</nav>
